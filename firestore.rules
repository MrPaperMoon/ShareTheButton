rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sharedButtons/{token} {
      function signedIn() { return request.auth != null; }
      function validButton() {
        let data = request.resource.data;
        return data.keys().hasAll(['ownerId', 'id', 'color', 'title', 'actionText', 'notificationText'])
          && data.keys().hasOnly(['ownerId', 'id', 'color', 'title', 'actionText', 'notificationText'])
          && data.ownerId == request.auth.uid
          && data.id is string && data.id.size() > 0 && data.id.size() <= 128
          && data.color is int
          && data.color >= -2147483648 && data.color <= 2147483647
          && data.title is string && data.title.size() > 0 && data.title.size() <= 40
          && data.actionText is string && data.actionText.size() > 0 && data.actionText.size() <= 24
          && data.notificationText is string && data.notificationText.size() > 0 && data.notificationText.size() <= 200;
      }
      // Button documents are keyed by button UUID. Collection enumeration is forbidden.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && token.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && request.resource.data.id == token && validButton();
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.id == resource.data.id && request.resource.data.id == token && validButton();
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /buttonLinks/{token} {
      function validLink() {
        let data = request.resource.data;
        return data.keys().hasAll(['ownerId', 'buttonId'])
          && data.keys().hasOnly(['ownerId', 'buttonId'])
          && data.ownerId == request.auth.uid
          && data.buttonId is string
          && getAfter(/databases/$(database)/documents/sharedButtons/$(data.buttonId)).data.ownerId == request.auth.uid;
      }
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && token.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}')
        && validLink();
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && request.resource.data.buttonId == resource.data.buttonId && validLink();
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
